# Define an explicit deployment target for CocoaPods integration.
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static

  # Suppress all warnings from CocoaPods dependencies (plugins, Flutter engine, etc.)
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Xcode module verification can fail for Flutter pod headers on device builds.
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      # Avoid Xcode warnings from pods that still declare very old deployment targets.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Prevent Xcode 26 script sandbox from flagging Flutter-generated artifacts.
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      # Avoid stale-file root-path validation failures in Xcode 26 build scripts.
      config.build_settings['USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES'] = 'NO'
      # Suppress all C/ObjC compiler warnings from pod targets.
      config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
      # Suppress all Swift compiler warnings from pod targets.
      config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
      # Disable code signing for pod frameworks — Xcode recommends this and
      # would otherwise show a "Perform Changes" prompt on every build.
      config.build_settings['CODE_SIGN_IDENTITY'] = ''
      config.build_settings['CODE_SIGNING_REQUIRED'] = 'NO'
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
        # Remove Swift embed settings that Xcode flags on Pods-Runner / Pods-RunnerTests.
        config.build_settings.delete('ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES')
        config.build_settings.delete('EMBEDDED_CONTENT_CONTAINS_SWIFT')
    end

    if ['CwlCatchExceptionSupport', 'CwlCatchException'].include?(target.name)
      target.build_configurations.each do |config|
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      end
    end
  end

  # Xcode 15+ recommends removing these legacy embed-Swift settings from Runner.
  # They can be injected via Pods-Runner xcconfig includes, so strip them after pod generation.
  pods_runner_support = File.join(installer.sandbox.target_support_files_root, 'Pods-Runner')
  Dir.glob(File.join(pods_runner_support, '*.xcconfig')).each do |xcconfig_path|
    next unless File.file?(xcconfig_path)

    content = File.read(xcconfig_path)
    cleaned = content
      .gsub(/^\s*ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES\s*=.*\n/, '')
      .gsub(/^\s*EMBEDDED_CONTENT_CONTAINS_SWIFT\s*=.*\n/, '')

    File.write(xcconfig_path, cleaned) if cleaned != content
  end

  # Force-disable module verifier in Pods project for Xcode 26 compatibility.
  # Some Flutter plugin frameworks fail VerifyModule even when the target setting
  # is set in-memory during post_install.
  pods_project_file = File.join(installer.pods_project.path.to_s, 'project.pbxproj')
  if File.file?(pods_project_file)
    pbxproj = File.read(pods_project_file)
    patched = pbxproj
      .gsub('ENABLE_MODULE_VERIFIER = YES;', 'ENABLE_MODULE_VERIFIER = NO;')
      .gsub(/^\s*ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = .*\n/, '')
      .gsub(/^\s*EMBEDDED_CONTENT_CONTAINS_SWIFT = .*\n/, '')
    File.write(pods_project_file, patched) if patched != pbxproj
  end

  # Strip legacy Xcode suggestions from the app project itself as well.
  runner_projects = [
    File.expand_path('Runner.xcodeproj/project.pbxproj', __dir__),
    File.expand_path('ios/Runner.xcodeproj/project.pbxproj', __dir__),
  ]

  runner_projects.each do |runner_project_file|
    next unless File.file?(runner_project_file)

    pbxproj = File.read(runner_project_file)
    patched = pbxproj
      .gsub(/^\s*"CODE_SIGN_IDENTITY\[sdk=iphoneos\*\]" = "iPhone Developer";\n/, '')
      .gsub(/^\s*ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES = .*\n/, '')
      .gsub(/^\s*EMBEDDED_CONTENT_CONTAINS_SWIFT = .*\n/, '')
      .gsub('ENABLE_MODULE_VERIFIER = YES;', 'ENABLE_MODULE_VERIFIER = NO;')

    File.write(runner_project_file, patched) if patched != pbxproj
  end
end
